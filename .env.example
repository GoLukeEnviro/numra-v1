# Copy this file to .env and fill in real values before running docker compose or the
# app locally. Never commit a real .env file.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://numra:numra_dev_password@127.0.0.1:5432/numra_dev
POSTGRES_PASSWORD=numra_dev_password

# --- Application ---
APP_TIMEZONE=Europe/Berlin
ENVIRONMENT=development

# --- Sessions / Auth ---
SESSION_SECRET=change-me-to-a-long-random-value
ALLOW_SELF_SIGNUP=false

# Safe default: verification and reset delivery stay unavailable until a real SMTP
# provider is configured. Use "logging" only outside production.
EMAIL_BACKEND=disabled

# --- SMTP transport (only needed when EMAIL_BACKEND=smtp) ---
# The compose stack forwards these keys to api/worker/analysis-worker; empty
# values are treated as unset, so leaving them blank keeps the defaults working.
# SMTP_HOST=smtp.provider.example
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@your-domain.example
# SMTP_FROM_NAME=AVENYTH
# SMTP_STARTTLS=true    # port 587 (plaintext + STARTTLS, the common default)
# SMTP_USE_TLS=false    # port 465 (implicit TLS; mutually exclusive with STARTTLS)
# SMTP_TIMEOUT_SECONDS=10.0

# --- LLM provider selection ---
# The single source of truth for which LLM backend the worker uses. One of:
#   disabled  (default) - report generation fails fast with LLM_UNAVAILABLE; no LLM
#                          call is ever attempted. Safe default, app stays healthy.
#   ollama    - real Ollama Cloud calls; requires OLLAMA_BASE_URL/OLLAMA_API_KEY below.
#   mock      - deterministic, network-free canned content. NOT permitted when
#               ENVIRONMENT=production (the app refuses to start).
NUMRA_LLM_PROVIDER=disabled
# D4 closed beta: true = cost-intensive features also need an individual beta grant
# (see docs/ops/2026-10-09-d4-beta-transition.md; keep false until the backfill ran)
BETA_GATE_ENFORCED=false
# D4 quotas per user (empty = unlimited, nothing counted). Only the api service reads them.
# Values are recommendations only in docs/ops/2026-10-10-d4-limits-and-budget.md.
# QUOTA_REPORT_MAX=
# QUOTA_REPORT_WINDOW_SECONDS=
# QUOTA_REPORT_MAX_CONCURRENT=
# QUOTA_ANALYSIS_MAX=
# QUOTA_ANALYSIS_WINDOW_SECONDS=
# QUOTA_ANALYSIS_MAX_CONCURRENT=
# QUOTA_COPILOT_MAX=
# QUOTA_COPILOT_WINDOW_SECONDS=
# QUOTA_COPILOT_MAX_CONCURRENT=
# QUOTA_ACTIVE_STALE_SECONDS=
NUMRA_LLM_MAX_RETRIES=3
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
NUMRA_LLM_MODEL_PREMIUM=deepseek-v4-pro:0813
NUMRA_LLM_MODEL_FAST=deepseek-v4.1-flash
NUMRA_LLM_TEMPERATURE=1.0
NUMRA_LLM_TOP_P=1.0
NUMRA_LLM_TIMEOUT_SECONDS=120

# --- PDF service ---
PDF_INTERNAL_TOKEN=change-me-to-a-long-random-value
# Base URL the API uses to reach the PDF service, both for its own health check
# (GET {PDF_INTERNAL_URL}/health/ready) and for real export rendering dispatch
# (POST {PDF_INTERNAL_URL}/render/report). Leave empty to report "pdf": "disabled" and
# fail export creation with a clear error instead of attempting a request to nothing.
PDF_INTERNAL_URL=http://localhost:4300

# --- Exports ---
# Local filesystem directory rendered export files (PDFs) are written to.
EXPORT_STORAGE_DIR=./data/exports

# --- Rate limiting ---
# "memory" (default) is a single-process, dev/test-only counter. NOT permitted when
# ENVIRONMENT=production (the app refuses to start) -- a multi-instance deployment
# needs a shared counter, or each instance enforces the limit independently.
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# --- Web ---
# Server-only (never NEXT_PUBLIC_-prefixed, never baked into the client bundle): the
# Next.js server proxies same-origin /api/* to this URL at runtime (next.config.mjs's
# rewrites()) so the browser never needs to know the real backend origin.
API_INTERNAL_URL=http://localhost:8000
# Public base URL of the web app (apps/web) -- the API builds connection-invitation
# redeem links and verify-email/reset-password links from this (never derived from
# request Host/Forwarded headers). Matches the real local Next.js port, not Vite's
# 5173, which this app does not use.
WEB_APP_BASE_URL=http://localhost:3000

# --- Logging / limits ---
LOG_LEVEL=INFO
REPORT_MAX_WORDS=30000

# --- V2 feature flags ---
# Die sieben V2-Flags liegen in der DB-Tabelle feature_flags (Aenderung nur ueber
# /admin/flags). Die frueheren AVENYTH_*_ENABLED-Variablen sind ohne Wirkung.
# Erstbefuellung einer frischen DB (Job flags-init): all-off | beta | audit-all-on
# NUMRA_FLAGS_PROFILE=

# --- Web-BFF <-> API Shared Secret (Vertrauensgrenze, siehe docs/ops/2026-10-10-proxy-secret-rollout.md) ---
# Nur Platzhalter. Echten Wert erzeugen mit `openssl rand -base64 48`, nur in der
# Server-Env-Datei ablegen (nie ins Repo, nie als NEXT_PUBLIC_*, nie als Prozessargument).
# Mindestlänge 32 Zeichen. Dieselbe Variable gilt für API und Web-Server.
INTERNAL_PROXY_SHARED_SECRET=
# Nur während einer Rotation/eines Rückrolls: das jeweils andere (alte) Secret, API-seitig.
INTERNAL_PROXY_SHARED_SECRET_PREVIOUS=
# false = Übergangsmodus; true erst nach erfolgreicher Umstellung des Web-Servers.
PROXY_SECRET_ENFORCED=false
# Peer-Netze (CIDR, kommagetrennt), von denen die API eine weitergeleitete Client-IP
# akzeptiert, z. B. das Compose-Netz des Web-Containers. Leer = nie.
TRUSTED_PROXY_CIDRS=
# Web-Server: Anzahl vertrauenswürdiger Reverse-Proxys vor Next.js (0 = keine Client-IP).
TRUSTED_PROXY_HOPS=0