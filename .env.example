# Copy this file to .env and fill in real values before running docker compose or the
# app locally. Never commit a real .env file.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://numra:numra_dev_password@127.0.0.1:5432/numra_dev
POSTGRES_PASSWORD=numra_dev_password

# --- Application ---
APP_TIMEZONE=Europe/Berlin
ENVIRONMENT=development

# --- Sessions / Auth ---
SESSION_SECRET=change-me-to-a-long-random-value
ALLOW_SELF_SIGNUP=false

# --- LLM provider selection ---
# The single source of truth for which LLM backend the worker uses. One of:
#   disabled  (default) - report generation fails fast with LLM_UNAVAILABLE; no LLM
#                          call is ever attempted. Safe default, app stays healthy.
#   ollama    - real Ollama Cloud calls; requires OLLAMA_BASE_URL/OLLAMA_API_KEY below.
#   mock      - deterministic, network-free canned content. NOT permitted when
#               ENVIRONMENT=production (the app refuses to start).
NUMRA_LLM_PROVIDER=disabled
NUMRA_LLM_MAX_RETRIES=3
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
NUMRA_LLM_MODEL_PREMIUM=deepseek-v4-pro:cloud
NUMRA_LLM_MODEL_FAST=deepseek-v4-flash:cloud
NUMRA_LLM_TEMPERATURE=0.2
NUMRA_LLM_TIMEOUT_SECONDS=120

# --- PDF service ---
PDF_INTERNAL_TOKEN=change-me-to-a-long-random-value
# Base URL the API uses to reach the PDF service, both for its own health check
# (GET {PDF_INTERNAL_URL}/health/ready) and for real export rendering dispatch
# (POST {PDF_INTERNAL_URL}/render/report). Leave empty to report "pdf": "disabled" and
# fail export creation with a clear error instead of attempting a request to nothing.
PDF_INTERNAL_URL=http://localhost:4300

# --- Exports ---
# Local filesystem directory rendered export files (PDFs) are written to.
EXPORT_STORAGE_DIR=./data/exports

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Logging / limits ---
LOG_LEVEL=INFO
REPORT_MAX_WORDS=30000
