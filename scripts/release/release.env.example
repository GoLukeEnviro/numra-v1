# Beispielkonfiguration fuer scripts/release/numra-release.sh und numra-drill.sh.
# Kopieren nach z. B. ~/release-<ziel>.env (Rechte 0600) und anpassen. Eine Datei je Ziel:
# CONFIG_TARGET muss zum --target-Parameter passen, sonst verweigert das Skript den Lauf.
# Enthaelt bewusst KEINE Secrets: Env-Dateien der Stacks werden nur als Pfad uebergeben.
# Die Werte unten sind ein dokumentiertes Beispiel fuer ein Einzelhost-Layout (Compose-Projekt
# "numra-prod"); es gibt keine Defaults im Skript.

CONFIG_TARGET=prod                          # audit | prod

# Compose-Stack
PROJECT=numra-prod                          # Compose-Projektname; Container heissen <PROJECT>-<dienst>-1
COMPOSE_FILE=/opt/numra/compose.production.yml
COMPOSE_EXTRA_FILES=""                      # weitere -f Dateien (Overlays), leer = keine
ENV_FILE=/etc/numra/numra.env               # nur als --env-file durchgereicht, nie gelesen
PROJECT_DIR=/opt/numra                     # --project-directory: Build-Kontexte/Binds loesen sich dagegen auf (Default: Verzeichnis von COMPOSE_FILE)
COMPOSE_SRC_IN_REPO=deploy/compose.production.yml   # Pfad der Compose-Datei im Repo; leer = Compose wird nicht ersetzt
REPO_DIR=/opt/numra/repo                    # Deployment-Checkout (HEAD muss dem Marker entsprechen)

# Dienste
WRITER_SERVICES="api web worker analysis-worker"   # werden gestoppt/neu erstellt
UNTOUCHED_SERVICES="postgres redis pdf"            # muessen waehrend des Releases unveraendert bleiben
BUILD_SERVICES="api web worker analysis-worker"    # Default: WRITER_SERVICES
MIGRATE_SERVICE=migrate                     # Einmal-Dienst fuer alembic upgrade; leer = keine Migration
FLAGS_INIT_SERVICE=flags-init               # optional
IMAGE_PREFIX=numra-prod-                    # Image-Namen: <IMAGE_PREFIX><dienst>:latest / :rollback-<TS>

# Datenbank (nur SELECT-Abfragen im postgres-Container, Zugang per lokalem Socket)
PG_SERVICE=postgres
DB_USER=numra
DB_NAME=numra
INVARIANT_SQL="select md5(string_agg(name||enabled::text||updated_at::text, ',' order by name)) from feature_flags"

# Readiness, Marker, Zustand
READY_URL=http://127.0.0.1:17800/v1/health/ready
MARKER_FILE=/var/lib/numra/deployed_sha
STATE_DIR=/home/hermes/release-state        # State, Baseline, Staging der neuen Compose
BASELINE_FILE=""                            # Default: $STATE_DIR/baseline-<target>.txt
REPORT_DIR=/home/hermes/release-reports     # Markdown+JSON-Berichte und release.log (einziger Schreibpfad im Dry-Run)
MAX_SMOKE_AGE_S=3600                        # maximales Alter des Abnahmeberichts fuer die Marker-Phase

# Sicherungen
BACKUP_DIR=/var/lib/numra/backups
BACKUP_GLOB='numra-*.dump'                  # Dump + <name>.sha256 daneben
BACKUP_MAX_AGE_S=93600                      # pre/prep: juengster Dump maximal so alt (26 h)
FRESH_DUMP_MAX_AGE_S=300                    # switch: Pre-Deploy-Dump maximal so alt
RELEASE_BACKUP_ROOT=/var/lib/numra/release-backups
BACKUP_FILES="/etc/numra/numra.env /etc/numra/healthcheck.env /usr/local/bin/numra-healthcheck.sh /usr/local/bin/numra-backup.sh /etc/systemd/system/numra-healthcheck.service /etc/systemd/system/numra-healthcheck.timer /etc/systemd/system/numra-backup.service /etc/systemd/system/numra-backup.timer"
BACKUP_SERVICE=numra-backup.service         # Pflicht fuer switch: oneshot-Unit, die den Pre-Deploy-Dump erzeugt
HEALTH_TIMER=numra-healthcheck.timer        # waehrend des Fensters gestoppt; leer = keiner
MIN_FREE_GB=50
DISK_PATH=/

SUDO_CMD=sudo                               # nur aus dieser Datei, nie aus der Umgebung; leer = ohne sudo (Tests/rootless)
HEALTHY_WAIT_ROUNDS=60
HEALTHY_WAIT_S=5
MIN_SMOKE_PASS=10                           # Mindestzahl bestandener Pruefungen im Abnahmebericht (marker)
POST_SWITCH_WAIT_S=20                       # Wartezeit vor dem Traceback-/RestartCount-Check nach switch
REDACT_ENV="PGPASSWORD"                     # Namen von Umgebungsvariablen, deren Werte aus Log/Bericht entfernt werden
# Rechte: diese Datei wird als Shell gelesen. Sie muss dem aufrufenden Benutzer oder root gehoeren und darf
# fuer Gruppe/Andere nicht schreibbar sein (chmod 600), sonst verweigert das Skript (Exit 2).
