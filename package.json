{
  "name": "numra-v1",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate-schema": "pnpm --filter @numra/schema generate",
    "web:dev": "pnpm --filter @numra/web dev",
    "web:build": "pnpm --filter @numra/web build",
    "web:lint": "pnpm --filter @numra/web lint",
    "web:typecheck": "pnpm --filter @numra/web typecheck",
    "web:test": "pnpm --filter @numra/web test -- --run",
    "web:e2e": "pnpm --filter @numra/web exec playwright test",
    "pdf:test": "pnpm --filter @numra/pdf test",
    "verify": "python3 scripts/verify.py"
  }
}
